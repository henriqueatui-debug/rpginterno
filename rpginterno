        const div = document.createElement("div");
        div.className = "bg-fantasy-dark/60 p-1.5 rounded border border-fantasy-border flex items-center justify-between";
        div.innerHTML = `<span><i class="fa-solid fa-box text-amber-400 mr-1.5"></i> ${item}</span>`;
        invList.appendChild(div);
      });

      // Habilidades
      const habList = document.getElementById("habilidadesList");
      habList.innerHTML = gameState.player.habilidades.length ? "" : '<span class="text-gray-500 italic">Nenhuma habilidade especial</span>';
      gameState.player.habilidades.forEach(hab => {
        const div = document.createElement("div");
        div.className = "bg-fantasy-dark/60 p-2 rounded border border-fantasy-border space-y-1";
        div.innerHTML = `<div class="flex justify-between font-semibold text-amber-300"><span>${hab.nome}</span><span class="text-blue-400">MP: ${hab.custoMp}</span></div><div class="text-[11px] text-gray-400">${hab.descricao}</div>`;
