      input.select();
      navigator.clipboard.writeText(input.value);
            alert("Código de save copiado para a área de transferência!");      
    }

    async function salvarProgressoNuvem() {
      if (!db || !gameState.saveCode) return;
      try {
        await db.collection("saves").doc(gameState.saveCode).set({
          gameState: gameState,
          updatedAt: firebase.firestore.FieldValue.serverTimestamp()
        });
      } catch(e) {
            console.warn("Erro ao salvar no Firestore:", e);    
      }
    }

