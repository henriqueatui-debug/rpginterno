<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crônicas de Éter - RPG de Mesa IA</title>
  <!-- Tailwind CSS para Estilização Moderna -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            fantasy: {
              dark: '#0d0f12',
              card: '#161922',
              border: '#2a2f3d',
              gold: '#d4af37',
              goldHover: '#f3c643',
              crimson: '#8b0000',
              crimsonHover: '#a30000'
            }
          }
        }
      }
    }
  </script>
  <!-- Firebase SDKs para Sincronização em Nuvem (Save Code) -->
  <script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-firestore-compat.js"></script>
  <!-- Google Fonts & FontAwesome -->
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #0d0f12;
      color: #e2e8f0;
    }
    .font-cinzel {
      font-family: 'Cinzel', serif;
    }
     /* Estilo de pergaminho / painéis de fantasia */ 
    .fantasy-box {
      background: linear-gradient(135deg, #161922 0%, #101218 100%);
      border: 1px solid #2a2f3d;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
    }
    .fantasy-button {
      background: linear-gradient(135deg, #8b0000 0%, #5a0000 100%);
      border: 1px solid #a30000;
      transition: all 0.2s ease;
    }
    .fantasy-button:hover {
      background: linear-gradient(135deg, #a30000 0%, #700000 100%);
      box-shadow: 0 0 15px rgba(139, 0, 0, 0.5);
      transform: translateY(-1px);
    }
    .gold-button {
      background: linear-gradient(135deg, #d4af37 0%, #aa8c2c 100%);
      color: #0d0f12;
      border: 1px solid #f3c643;
      font-weight: 700;
      transition: all 0.2s ease;
    }
    .gold-button:hover {
      background: linear-gradient(135deg, #f3c643 0%, #d4af37 100%);
      box-shadow: 0 0 15px rgba(212, 175, 55, 0.5);
      transform: translateY(-1px);
    }
    /* Animação suave de rolagem */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0d0f12;
    }
    ::-webkit-scrollbar-thumb {
      background: #2a2f3d;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #d4af37;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased">

  <!-- TOPO / HEADER -->
  <header class="bg-fantasy-card border-b border-fantasy-border px-4 py-3 flex justify-between items-center z-30 sticky top-0 shadow-lg">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center shadow-md">
        <i class="fa-solid fa-dice-d20 text-xl text-fantasy-dark font-bold"></i>
      </div>
      <div>
        <h1 class="font-cinzel font-bold text-lg text-amber-400 tracking-wider">CRÔNICAS DE ÉTER</h1>
        <p class="text-xs text-gray-400">RPG de Mesa com Mestre IA</p>
      </div>
    </div>

    <div id="gameHeaderInfo" class="hidden items-center space-x-4">
      <div class="text-right hidden sm:block">
        <div class="text-xs text-amber-300 font-semibold" id="headerSaveCode">CÓDIGO: CARREGANDO...</div>
        <div class="text-xs text-gray-400" id="headerPlayerTitle">Guerreiro Nv. 1</div>
      </div>
      <button onclick="abrirModalSave()" class="px-3 py-1.5 bg-fantasy-border hover:bg-amber-600 hover:text-white rounded text-xs font-medium transition flex items-center space-x-1.5">
        <i class="fa-solid fa-cloud"></i>
        <span class="hidden md:inline">Salvar / Sala</span>
      </button>
      <button onclick="abrirModalConfig()" class="p-2 bg-fantasy-border hover:bg-gray-700 rounded text-gray-300 transition" title="Configurar API Key do Gemini">
        <i class="fa-solid fa-gear"></i>
      </button>
    </div>
  </header>

  <!-- CONTEÚDO PRINCIPAL -->
  <main class="flex-1 flex flex-col md:flex-row max-w-7xl w-full mx-auto p-3 sm:p-4 gap-4">

    <!-- TELA 1: CRIAÇÃO DE PERSONAGEM / ENTRADA -->
    <section id="screenSetup" class="flex-1 flex flex-col justify-center items-center py-6">
      <div class="max-w-xl w-full fantasy-box rounded-xl p-6 sm:p-8 space-y-6">
        <div class="text-center space-y-2">
          <h2 class="font-cinzel text-2xl sm:text-3xl font-bold text-amber-400">Inicie Sua Aventura</h2>
          <p class="text-sm text-gray-400">Escolha seu herói, defina seu destino e deixe a Inteligência Artificial moldar o universo.</p>
        </div>

        <div class="space-y-4">
          <div>
            <label class="block text-xs font-semibold uppercase text-amber-300 mb-1">Nome do Personagem</label>
            <input type="text" id="inputNome" placeholder="Ex: Arthur Coração de Leão" class="w-full bg-fantasy-dark border border-fantasy-border rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-amber-400 transition">
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase text-amber-300 mb-1">Escolha sua Classe</label>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5" id="classeSelector">
              <!-- Injetado via JS -->
            </div>
            <p id="classeDescricao" class="text-xs text-gray-400 mt-2 italic bg-fantasy-dark/50 p-2.5 rounded border border-fantasy-border/50">Selecione uma classe acima.</p>
          </div>

          <div class="pt-2 flex flex-col sm:flex-row gap-3">
            <button onclick="iniciarNovoJogo()" class="flex-1 gold-button py-3 px-6 rounded-lg text-sm flex items-center justify-center space-x-2">
              <i class="fa-solid fa-play"></i>
              <span>Desbravar Novo Reino</span>
            </button>
            <button onclick="abrirModalSave()" class="py-3 px-5 bg-fantasy-border hover:bg-gray-700 text-gray-200 rounded-lg text-sm font-medium transition flex items-center justify-center space-x-2">
              <i class="fa-solid fa-key"></i>
              <span>Retomar por Código</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- TELA 2: PAINEL PRINCIPAL DO JOGO -->
    <section id="screenGame" class="hidden flex-1 flex flex-col lg:flex-row gap-4">
      
      <!-- COLUNA ESQUERDA: FICHA E STATUS DO PERSONAGEM -->
      <div class="w-full lg:w-80 flex flex-col gap-4">
        
        <!-- Bloco de Identidade e HP/MP -->
        <div class="fantasy-box rounded-xl p-4 space-y-3">
          <div class="flex justify-between items-start">
            <div>
              <h3 id="charNameDisplay" class="font-cinzel font-bold text-base text-amber-400">Herói</h3>
              <p id="charClassDisplay" class="text-xs text-gray-400">Guerreiro • Nível <span id="charLevelDisplay">1</span></p>
            </div>
            <button onclick="abrirModalAtributos()" class="text-xs bg-amber-500/20 text-amber-300 border border-amber-500/30 px-2 py-1 rounded hover:bg-amber-500/30 transition flex items-center space-x-1" id="btnAtributosPendente" style="display:none;">
              <i class="fa-solid fa-circle-exclamation text-amber-400 animate-pulse"></i>
              <span>Atributos</span>
            </button>
          </div>

          <!-- Barras de HP / MP / XP -->
          <div class="space-y-2 text-xs">
            <div>
              <div class="flex justify-between text-gray-300 mb-1">
                <span>HP (Vida)</span>
                <span id="hpText">100 / 100</span>
              </div>
              <div class="w-full bg-fantasy-dark h-2 rounded-full overflow-hidden border border-fantasy-border">
                <div id="hpBar" class="bg-red-600 h-full transition-all duration-300" style="width: 100%"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-gray-300 mb-1">
                <span>MP (Mana/Vigor)</span>
                <span id="mpText">50 / 50</span>
              </div>
              <div class="w-full bg-fantasy-dark h-2 rounded-full overflow-hidden border border-fantasy-border">
                <div id="mpBar" class="bg-blue-600 h-full transition-all duration-300" style="width: 100%"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-gray-300 mb-1">
                <span>XP (Experiência)</span>
                <span id="xpText">0 / 100</span>
              </div>
              <div class="w-full bg-fantasy-dark h-1.5 rounded-full overflow-hidden border border-fantasy-border">
                <div id="xpBar" class="bg-amber-500 h-full transition-all duration-300" style="width: 0%"></div>
              </div>
            </div>
          </div>

          <!-- Atributos Resumidos -->
          <div class="pt-2 border-t border-fantasy-border grid grid-cols-4 gap-1.5 text-center text-xs">
            <div class="bg-fantasy-dark/60 p-1.5 rounded border border-fantasy-border">
              <span class="block text-[10px] text-gray-400">FOR</span>
              <span id="statFOR" class="font-bold text-amber-300">10</span>
            </div>
            <div class="bg-fantasy-dark/60 p-1.5 rounded border border-fantasy-border">
              <span class="block text-[10px] text-gray-400">DES</span>
              <span id="statDES" class="font-bold text-amber-300">10</span>
            </div>
            <div class="bg-fantasy-dark/60 p-1.5 rounded border border-fantasy-border">
              <span class="block text-[10px] text-gray-400">CON</span>
              <span id="statCON" class="font-bold text-amber-300">10</span>
            </div>
            <div class="bg-fantasy-dark/60 p-1.5 rounded border border-fantasy-border">
              <span class="block text-[10px] text-gray-400">INT</span>
              <span id="statINT" class="font-bold text-amber-300">10</span>
            </div>
            <div class="bg-fantasy-dark/60 p-1.5 rounded border border-fantasy-border">
              <span class="block text-[10px] text-gray-400">SAB</span>
              <span id="statSAB" class="font-bold text-amber-300">10</span>
            </div>
            <div class="bg-fantasy-dark/60 p-1.5 rounded border border-fantasy-border">
              <span class="block text-[10px] text-gray-400">CAR</span>
              <span id="statCAR" class="font-bold text-amber-300">10</span>
            </div>
            <div class="bg-fantasy-dark/60 p-1.5 rounded border border-fantasy-border">
              <span class="block text-[10px] text-gray-400">SOR</span>
              <span id="statSOR" class="font-bold text-amber-300">10</span>
            </div>
            <div class="bg-fantasy-dark/60 p-1.5 rounded border border-fantasy-border">
              <span class="block text-[10px] text-gray-400">PER</span>
              <span id="statPER" class="font-bold text-amber-300">10</span>
            </div>
          </div>
        </div>

        <!-- Inventário e Habilidades -->
        <div class="fantasy-box rounded-xl p-4 space-y-4 flex-1">
          <div>
            <h4 class="font-cinzel text-xs font-bold text-amber-400 uppercase tracking-wider mb-2 flex items-center justify-between">
              <span>Inventário & Tesouros</span>
              <i class="fa-solid fa-box-open text-gray-400"></i>
            </h4>
            <div id="inventarioList" class="space-y-1.5 max-h-36 overflow-y-auto pr-1 text-xs">
              <!-- Itens injetados via JS -->
            </div>
          </div>

          <div class="pt-2 border-t border-fantasy-border">
            <h4 class="font-cinzel text-xs font-bold text-amber-400 uppercase tracking-wider mb-2 flex items-center justify-between">
              <span>Golpes & Habilidades</span>
              <i class="fa-solid fa-wand-magic-sparkles text-gray-400"></i>
            </h4>
            <div id="habilidadesList" class="space-y-2 max-h-44 overflow-y-auto pr-1 text-xs">
              <!-- Habilidades injetadas via JS -->
            </div>
          </div>
        </div>

      </div>

      <!-- COLUNA DIREITA: NARRATIVA, MONSTROS E ESCOLHAS -->
      <div class="flex-1 flex flex-col gap-4">
        
        <!-- Painel de Combate / Monstro Ativo (Oculto se não houver combate) -->
        <div id="combatPanel" class="hidden fantasy-box rounded-xl p-4 border-red-900/60 bg-gradient-to-r from-red-950/30 to-fantasy-card">
          <div class="flex flex-col sm:flex-row items-center gap-4">
            <div id="monsterImageContainer" class="w-24 h-24 rounded-lg bg-fantasy-dark border border-red-900/50 overflow-hidden flex-shrink-0 relative flex items-center justify-center">
              <i class="fa-solid fa-dragon text-3xl text-red-500 animate-pulse"></i>
            </div>
            <div class="flex-1 w-full space-y-2">
              <div class="flex justify-between items-start">
                <div>
                  <div class="flex items-center space-x-2">
                    <h4 id="monsterName" class="font-cinzel font-bold text-base text-red-400">Monstro Agressivo</h4>
                    <span id="monsterBadge" class="text-[10px] bg-red-900/50 text-red-300 px-2 py-0.5 rounded border border-red-700/50">Comum</span>
                  </div>
                  <p id="monsterDesc" class="text-xs text-gray-300 mt-0.5">Criatura ameaçadora pronta para o bote.</p>
                </div>
              </div>
              <div>
                <div class="flex justify-between text-xs text-gray-300 mb-1">
                  <span>Vida do Inimigo</span>
                  <span id="monsterHpText">50 / 50</span>
                </div>
                <div class="w-full bg-fantasy-dark h-2 rounded-full overflow-hidden border border-red-900/40">
                  <div id="monsterHpBar" class="bg-red-600 h-full transition-all duration-300" style="width: 100%"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Bloco de História / Narração Principal -->
        <div class="fantasy-box rounded-xl p-5 sm:p-6 flex-1 flex flex-col justify-between min-h-[360px] relative">
          
          <!-- Imagem de Cena (Se houver) -->
          <div id="sceneImageContainer" class="hidden mb-4 w-full h-48 rounded-lg overflow-hidden border border-fantasy-border relative bg-fantasy-dark flex items-center justify-center">
            <img id="sceneImage" src="" alt="Cena Atual" class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-t from-fantasy-dark/80 via-transparent to-transparent"></div>
          </div>

          <!-- Texto Narrativo -->
          <div class="space-y-4">
            <div class="flex items-center justify-between text-xs text-amber-400 font-semibold uppercase tracking-wider border-b border-fantasy-border pb-2">
              <span id="chapterTitle">Capítulo I: A Aurora Sombria</span>
              <span id="turnCounter" class="text-gray-400">Turno 1</span>
            </div>
            <div id="storyText" class="text-sm sm:text-base leading-relaxed text-gray-200 font-light space-y-3">
              Carregando as crônicas do destino...
            </div>
          </div>

          <!-- Loader de IA (Oculto por padrão) -->
          <div id="aiLoader" class="hidden absolute inset-0 bg-fantasy-dark/80 backdrop-blur-sm rounded-xl flex flex-col items-center justify-center space-y-3 z-20">
            <i class="fa-solid fa-dice-d20 text-4xl text-amber-400 animate-spin"></i>
            <p id="loaderText" class="font-cinzel text-sm text-amber-300 animate-pulse">O Mestre IA está tecendo o próximo destino...</p>
          </div>

          <!-- Bloco de Escolhas e Ações -->
          <div class="mt-6 pt-4 border-t border-fantasy-border space-y-3">
            <div id="choicesContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <!-- Botões de escolha injetados via JS -->
            </div>
            
            <!-- Ação personalizada do jogador -->
            <div class="flex gap-2 pt-2">
              <input type="text" id="customActionInput" placeholder="Ou digite o que deseja fazer (ex: Investigar a estátua...)" class="flex-1 bg-fantasy-dark border border-fantasy-border rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-amber-400 transition" onkeypress="if(event.key === 'Enter') enviarAcaoPersonalizada()">
              <button onclick="enviarAcaoPersonalizada()" class="fantasy-button px-4 py-2 rounded-lg text-xs font-medium text-white flex items-center space-x-1.5">
                <i class="fa-solid fa-paper-plane"></i>
                <span class="hidden sm:inline">Executar</span>
              </button>
            </div>
          </div>

        </div>

      </div>

    </section>

  </main>

  <!-- MODAL DE ATRIBUTOS (SUBIR DE NÍVEL) -->
  <div id="modalAtributos" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
    <div class="fantasy-box rounded-xl max-w-md w-full p-6 space-y-4">
      <div class="flex justify-between items-center border-b border-fantasy-border pb-3">
        <h3 class="font-cinzel font-bold text-lg text-amber-400 flex items-center space-x-2">
          <i class="fa-solid fa-angles-up text-amber-400"></i>
          <span>Distribuir Atributos</span>
        </h3>
        <button onclick="fecharModalAtributos()" class="text-gray-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
      </div>

      <p class="text-xs text-gray-300">Você subiu de nível! Distribua seus pontos disponíveis nas estatísticas do seu herói.</p>
      
      <div class="bg-amber-500/10 border border-amber-500/30 rounded-lg p-3 text-center">
        <span class="text-xs text-gray-300">Pontos Disponíveis:</span>
        <div id="modalPontosDisp" class="text-2xl font-bold text-amber-400">0</div>
      </div>

      <div class="space-y-2.5 max-h-60 overflow-y-auto pr-1 text-xs" id="modalStatsList">
        <!-- Lista de atributos com botões + / - injetada via JS -->
      </div>

      <div class="pt-2 flex justify-end">
        <button onclick="fecharModalAtributos()" class="gold-button px-5 py-2 rounded text-xs">Concluir</button>
      </div>
    </div>
  </div>

  <!-- MODAL DE SAVE / CÓDIGO DE SALA -->
  <div id="modalSave" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
    <div class="fantasy-box rounded-xl max-w-md w-full p-6 space-y-4">
      <div class="flex justify-between items-center border-b border-fantasy-border pb-3">
        <h3 class="font-cinzel font-bold text-lg text-amber-400 flex items-center space-x-2">
          <i class="fa-solid fa-cloud-arrow-up text-amber-400"></i>
          <span>Código de Salvamento (Nuven)</span>
        </h3>
        <button onclick="fecharModalSave()" class="text-gray-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
      </div>

      <div class="space-y-4 text-xs">
        <div>
          <label class="block text-gray-300 mb-1 font-semibold">Seu Código de Sala Atual:</label>
          <div class="flex gap-2">
            <input type="text" id="inputSaveCodeDisplay" readonly class="flex-1 bg-fantasy-dark border border-fantasy-border rounded px-3 py-2 text-amber-400 font-mono font-bold text-sm text-center">
            <button onclick="copiarCodigoSave()" class="px-4 bg-fantasy-border hover:bg-gray-700 text-white rounded font-medium transition"><i class="fa-solid fa-copy"></i> Copiar</button>
          </div>
          <p class="text-[11px] text-gray-400 mt-1">Guarde este código para continuar sua aventura em qualquer outro aparelho ou navegador!</p>
        </div>

        <div class="border-t border-fantasy-border pt-4">
          <label class="block text-gray-300 mb-1 font-semibold">Retomar Jogo Existente:</label>
          <div class="flex gap-2">
            <input type="text" id="inputRetomarCodigo" placeholder="Cole seu código aqui (Ex: DRAGON-8472)" class="flex-1 bg-fantasy-dark border border-fantasy-border rounded px-3 py-2 text-sm uppercase">
            <button onclick="carregarPorCodigo()" class="gold-button px-4 rounded font-medium">Carregar</button>
          </div>
        </div>
      </div>

      <div class="pt-2 flex justify-end">
        <button onclick="fecharModalSave()" class="px-4 py-2 bg-fantasy-border hover:bg-gray-700 rounded text-xs">Fechar</button>
      </div>
    </div>
  </div>

  <!-- MODAL DE CONFIGURAÇÃO (API KEY) -->
  <div id="modalConfig" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
    <div class="fantasy-box rounded-xl max-w-md w-full p-6 space-y-4">
      <div class="flex justify-between items-center border-b border-fantasy-border pb-3">
        <h3 class="font-cinzel font-bold text-lg text-amber-400 flex items-center space-x-2">
          <i class="fa-solid fa-key text-amber-400"></i>
          <span>Chave API Gemini</span>
        </h3>
        <button onclick="fecharModalConfig()" class="text-gray-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
      </div>

      <div class="space-y-3 text-xs">
        <p class="text-gray-300">Insira sua chave da API do Google Gemini para habilitar o Mestre IA imersivo e as ilustrações dinâmicas.</p>
        <input type="password" id="inputApiKey" placeholder="AIzaSy..." class="w-full bg-fantasy-dark border border-fantasy-border rounded px-3 py-2 text-sm focus:outline-none focus:border-amber-400">
      </div>

      <div class="pt-2 flex justify-end space-x-2">
        <button onclick="salvarApiKey()" class="gold-button px-5 py-2 rounded text-xs font-semibold">Salvar Chave</button>
        <button onclick="fecharModalConfig()" class="px-4 py-2 bg-fantasy-border hover:bg-gray-700 rounded text-xs">Cancelar</button>
      </div>
    </div>
  </div>

  <!-- LÓGICA E MOTOR DO JOGO -->
  <script>
    // Configuração Firebase (Emulador local / fallback público para testes)
    const firebaseConfig = {
      apiKey: "AIzaSyDummyKeyForLocalTestingModeOnly",
      authDomain: "cronicas-de-eter-rpg.firebaseapp.com",
      projectId: "cronicas-de-eter-rpg",
      storageBucket: "cronicas-de-eter-rpg.appspot.com",
      messagingSenderId: "123456789",
      appId: "1:123456789:web:abcdef"
    };

    let db = null;
    try {
      if (!firebase.apps.length) {
        firebase.initializeApp(firebaseConfig);
      }
      db = firebase.firestore();
    } catch(e) {
      console.warn("Modo offline ativado para Firebase:", e);
    }

    // Configurações e Classes
    const CLASSES_CONFIG = {
      Guerreiro: {
        baseStats: { for: 16, des: 12, con: 15, int: 8, sab: 10, car: 10, sor: 10, per: 11 },
        descricao: "Especialista em combate corpo a corpo, resistente e letal com armas pesadas."
      },
      Mago: {
        baseStats: { for: 8, des: 12, con: 10, int: 16, sab: 15, car: 11, sor: 12, per: 12 },
