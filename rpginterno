      });

      // Botão de Atributos Pendentes
      const btnAtribPendente = document.getElementById("btnAtributosPendente");
      if (gameState.player.pontosAtributoDisponiveis > 0) {
        btnAtribPendente.style.display = "flex";
      } else {
        btnAtribPendente.style.display = "none";
      }

      // Inventário
      const invList = document.getElementById("inventarioList");
      invList.innerHTML = gameState.player.inventario.length ? "" : '<span class="text-gray-500 italic">Vazio</span>';
