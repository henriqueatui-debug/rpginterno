    // Chamada à IA Mestre do Jogo (Gemini API)
    async function avancarHistoriaIA(acaoUsuario) {
      document.getElementById("aiLoader").classList.remove("hidden");
      
      const apiKey = gameState.apiKey || localStorage.getItem("gemini_api_key");
      
      let respostaData = null;

      if (apiKey) {
        try {
          const systemPrompt = `
            Você é o Dungeon Master de um RPG de mesa imersivo e dinâmico em Português.
            Retorne APENAS um objeto JSON válido (sem markdown, sem crases extras) com a seguinte estrutura exata:
            {
              "chapter": "Título do capítulo ou local atual",
              "narrative": "Texto narrativo rico e imersivo descrevendo o que acontece a seguir com base na ação do jogador.",
              "choices": [
                {"id": 1, "text": "Primeira escolha de ação"},
                {"id": 2, "text": "Segunda escolha de ação"},
                {"id": 3, "text": "Terceira escolha de ação"}
              ],
              "worldConsequences": ["Consequência marcante 1", "Consequência marcante 2"],
              "monster": null ou {
                "nome": "Nome do monstro",
                "raridade": "Comum, Elite ou Chefe",
                "hp": 60,
                "maxHp": 60,
                "ataque": 15,
                "descricao": "Descrição curta do monstro",
                "imagePrompt": "prompt em ingles para imagem do monstro"
              },
              "playerChanges": {
                "hpDelta": 0,
                "mpDelta": 0,
                "xpDelta": 25,
                "itensAdicionados": ["Item opcional ganho"],
                "novaHabilidade": null ou {"nome": "Nome do Golpe", "custoMp": 15, "descricao": "Efeito da habilidade"}
              },
              "sceneImagePrompt": "dark fantasy cinematic prompt in English for current scene background"
            }

            Estado atual do Jogador: Nome: ${gameState.player.nome}, Classe: ${gameState.player.classe}, Nível: ${gameState.player.nivel}, HP: ${gameState.player.hp}/${gameState.player.maxHp}, Atributos: FOR ${gameState.player.stats.for}, DES ${gameState.player.stats.des}, CON ${gameState.player.stats.con}, INT ${gameState.player.stats.int}, SAB ${gameState.player.stats.sab}, CAR ${gameState.player.stats.car}, SOR ${gameState.player.stats.sor}, PER ${gameState.player.stats.per}.
            Consequências anteriores do mundo: ${JSON.stringify(gameState.world.worldConsequences)}
            Monstro atual em combate: ${JSON.stringify(gameState.world.currentMonster)}
            Ação executada pelo jogador: "${acaoUsuario}"
          `;

          const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              contents: [{ parts: [{ text: systemPrompt }] }]
            })
          });

          const data = await response.json();
          let textResult = data.candidates?.[0]?.content?.parts?.[0]?.text || "";
          
          // Limpeza robusta de JSON retornado por LLM
          textResult = textResult.replace(/```json/g, "").replace(/```/g, "").trim();
          respostaData = JSON.parse(textResult);
        } catch (e) {
          console.warn("Falha na chamada Gemini API ou chave inválida. Usando motor offline de emergência.", e);
        }
      }

      // Mestre Reserva / Fallback Offline se API Key não estiver configurada ou falhar
      if (!respostaData) {
        respostaData = gerarFallbackNarrativo(acaoUsuario);
      }

      aplicarRespostaIA(respostaData);
      document.getElementById("aiLoader").classList.add("hidden");
      await salvarProgressoNuvem();
    }

    function gerarFallbackNarrativo(acao) {
      gameState.world.turn++;
      let monster = null;
      let hpDelta = 0;
      let xpGanho = 30;

      if (gameState.world.turn % 2 === 0) {
        monster = {
          nome: gameState.player.nivel > 2 ? "Cavaleiro Sombrio Corrompido" : "Goblin Batedor das Cavernas",
          raridade: gameState.player.nivel > 2 ? "Elite" : "Comum",
          hp: 40 + (gameState.player.nivel * 15),
          maxHp: 40 + (gameState.player.nivel * 15),
          ataque: 12 + (gameState.player.nivel * 3),
          descricao: "Um inimigo implacável surge bloqueando seu caminho nas sombras.",
          imagePrompt: "dark fantasy monster creature cinematic digital art"
        };
      } else {
        hpDelta = -5; // Pequeno desgaste nas explorações
      }

      return {
        chapter: `Capítulo I: O Despertar (Turno ${gameState.world.turn})`,
        narrative: `Você executa a ação: "${acao}". O ambiente reage instantaneamente aos seus passos. O eco de sua presença desperta forças ocultas no santuário, testando sua resiliência física e mental.`,
        choices: [
          { id: 1, text: "Avançar com cautela e postura defensiva" },
          { id: 2, text: "Atacar diretamente com força total" },
          { id: 3, text: "Buscar itens ou rotas alternativas no cenário" }
        ],
        worldConsequences: [`O jogador avançou corajosamente em direção a ${acao.substring(0, 20)}...`],
        monster: monster,
        playerChanges: {
          hpDelta: hpDelta,
          mpDelta: 5,
          xpDelta: xpGanho,
          itensAdicionados: gameState.world.turn === 2 ? ["Amuleto de Prata Antigo"] : [],
          novaHabilidade: gameState.world.turn === 3 ? { nome: "Golpe Celestial", custoMp: 12, descricao: "Causa dano radiante divino." } : null
        },
        sceneImagePrompt: "fantasy medieval dungeon mystery corridor cinematic digital art"
      };
    }

    function aplicarRespostaIA(resp) {
      if (resp.chapter) gameState.world.chapter = resp.chapter;
      if (resp.sceneImagePrompt) gameState.world.sceneImagePrompt = resp.sceneImagePrompt;
      if (resp.worldConsequences) {
        gameState.world.worldConsequences.push(...resp.worldConsequences);
      }

      gameState.world.currentMonster = resp.monster || null;
      document.getElementById("storyText").innerHTML = `<p>${resp.narrative.replace(/\n/g, '</p><p>')}</p>`;

      // Alterações no jogador
      if (resp.playerChanges) {
        const pc = resp.playerChanges;
        if (pc.hpDelta) gameState.player.hp = Math.max(0, Math.min(gameState.player.maxHp, gameState.player.hp + pc.hpDelta));
        if (pc.mpDelta) gameState.player.mp = Math.max(0, Math.min(gameState.player.maxMp, gameState.player.mp + pc.mpDelta));
        if (pc.xpDelta) {
          gameState.player.xp += pc.xpDelta;
          verificarLevelUp();
        }
        if (pc.itensAdicionados && pc.itensAdicionados.length > 0) {
          gameState.player.inventario.push(...pc.itensAdicionados);
        }
        if (pc.novaHabilidade) {
          gameState.player.habilidades.push(pc.novaHabilidade);
        }
      }

      // Renderizar Escolhas
      const choicesContainer = document.getElementById("choicesContainer");
      choicesContainer.innerHTML = "";
      if (resp.choices && resp.choices.length > 0) {
        resp.choices.forEach(ch => {
          const btn = document.createElement("button");
          btn.className = "p-3 bg-fantasy-dark hover:bg-fantasy-border border border-fantasy-border rounded-lg text-xs text-left text-gray-200 transition flex items-center space-x-2";
          btn.innerHTML = `<i class="fa-solid fa-angles-right text-amber-400"></i><span>${ch.text}</span>`;
          btn.onclick = () => selecionarEscolha(ch.text);
          choicesContainer.appendChild(btn);
        });
      }

      gameState.world.turn++;
      atualizarInterfaceCompleta();
    }

    function selecionarEscolha(textoEscolha) {
      document.getElementById("customActionInput").value = "";
      avancarHistoriaIA(textoEscolha);
    }

    function enviarAcaoPersonalizada() {
      const input = document.getElementById("customActionInput");
      const val = input.value.trim();
      if (!val) return;
      input.value = "";
      avancarHistoriaIA(val);
    }

    function verificarLevelUp() {
      if (gameState.player.xp >= gameState.player.maxXp) {
        gameState.player.nivel++;
        gameState.player.xp -= gameState.player.maxXp;
        gameState.player.maxXp = Math.floor(gameState.player.maxXp * 1.3);
        gameState.player.pontosAtributoDisponiveis += 3;
        
        // Recupera vida e mana ao subir de nível
        gameState.player.maxHp += 15;
        gameState.player.hp = gameState.player.maxHp;
        gameState.player.maxMp += 10;
        gameState.player.mp = gameState.player.maxMp;

        alert(`PARABÉNS! Você alcançou o Nível ${gameState.player.nivel}! Você recebeu 3 pontos de atributo para distribuir.`);
        abrirModalAtributos();
      }
    }

    // Modal de Atributos e Distribuição
    function abrirModalAtributos() {
      const modal = document.getElementById("modalAtributos");
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.getElementById("modalPontosDisp").innerText = gameState.player.pontosAtributoDisponiveis;
      
      const statsList = document.getElementById("modalStatsList");
      statsList.innerHTML = "";
      
      const nomesStats = {
         for: "Força (FOR)", des: "Destreza (DES)", con: "Constituição (CON)", int: "Inteligência (INT)", 
         sab: "Sabedoria (SAB)", car: "Carisma (CAR)", sor: "Sorte (SOR)", per: "Percepção (PER)" 
      };

      Object.keys(nomesStats).forEach(key => {
        const val = gameState.player.stats[key];
        const div = document.createElement("div");
        div.className = "flex items-center justify-between bg-fantasy-dark p-2.5 rounded border border-fantasy-border";
        div.innerHTML = `
          <div>
            <div class="font-semibold text-gray-200">${nomesStats[key]}</div>
             <div class="text-[10px] text-gray-400">Valor atual: <span id="modalVal_${key}" class="text-amber-400 font-bold">${val}</span></div> 
          </div>
          <div class="flex items-center space-x-2">
            <button onclick="alterarAtributoPendente('${key}', -1)" class="w-7 h-7 bg-fantasy-border hover:bg-gray-700 rounded text-white flex items-center justify-center font-bold">-</button>
            <button onclick="alterarAtributoPendente('${key}', 1)" class="w-7 h-7 bg-amber-600 hover:bg-amber-500 rounded text-white flex items-center justify-center font-bold">+</button>
          </div>
        `;
        statsList.appendChild(div);
      });
    }

    function alterarAtributoPendente(statKey, delta) {
      let pontosDisp = Number(gameState.player.pontosAtributoDisponiveis || 0);
      
      if (delta > 0 && pontosDisp > 0) {
        gameState.player.stats[statKey] = Number(gameState.player.stats[statKey] || 10) + 1;
        gameState.player.pontosAtributoDisponiveis = pontosDisp - 1;
      } else if (delta < 0) {
        const classeBase = CLASSES_CONFIG[gameState.player.classe]?.baseStats[statKey] || 10;
        const atual = Number(gameState.player.stats[statKey] || 10);
        if (atual > classeBase) {
          gameState.player.stats[statKey] = atual - 1;
          gameState.player.pontosAtributoDisponiveis = pontosDisp + 1;
        }
      }

      document.getElementById("modalPontosDisp").innerText = gameState.player.pontosAtributoDisponiveis;
      document.getElementById(`modalVal_${statKey}`).innerText = gameState.player.stats[statKey];
      atualizarInterfaceCompleta();
       salvarProgressoNuvem(); 
    }

     function fecharModalAtributos() { 
      document.getElementById("modalAtributos").classList.add("hidden");
      document.getElementById("modalAtributos").classList.remove("flex");
    }

