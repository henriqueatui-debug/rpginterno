      const sceneImgContainer = document.getElementById("sceneImageContainer");
      if (gameState.world.sceneImagePrompt) {
        sceneImgContainer.classList.remove("hidden");
        document.getElementById("sceneImage").src = `https://pollinations.ai/p/${encodeURIComponent(gameState.world.sceneImagePrompt)}`;
