    // Estado Global da Aplicação
    let gameState = {
      saveCode: "",
      apiKey: localStorage.getItem("gemini_api_key") || "",
      player: {
        nome: "",
        classe: "Guerreiro",
        nivel: 1,
        hp: 100,
        maxHp: 100,
        mp: 50,
        maxMp: 50,
        xp: 0,
        maxXp: 100,
        pontosAtributoDisponiveis: 0,
        stats: { for: 16, des: 12, con: 15, int: 8, sab: 10, car: 10, sor: 10, per: 11 },
        inventario: ["Espada Longa Enferrujada", "Poção de Vida Menor"],
        habilidades: [
          { nome: "Ataque Poderoso", custoMp: 10, descricao: "Um golpe brutal com força total." }
        ]
      },
      world: {
        chapter: "Capítulo I: A Aurora Sombria",
        turn: 1,
        historyLog: [],
        worldConsequences: [],
        currentMonster: null,
        sceneImagePrompt: "fantasy medieval dark ruined castle entrance cinematic lighting digital art"
      }
    };

    // Inicialização ao carregar a página
    window.addEventListener("DOMContentLoaded", () => {
      renderizarSeletorClasses();
    });

    function renderizarSeletorClasses() {
      const container = document.getElementById("classeSelector");
      container.innerHTML = "";
      Object.keys(CLASSES_CONFIG).forEach(classe => {
        const isSelected = gameState.player.classe === classe;
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = `p-2.5 rounded-lg border text-xs font-semibold text-left transition ${
          isSelected ? 'bg-amber-500/20 border-amber-400 text-amber-300' : 'bg-fantasy-dark border-fantasy-border text-gray-300 hover:border-gray-500'
        }`;
        btn.innerHTML = `<div class="font-cinzel text-sm">${classe}</div><div class="text-[10px] text-gray-400 truncate">${CLASSES_CONFIG[classe].descricao.substring(0,35)}...</div>`;
        btn.onclick = () => {
          gameState.player.classe = classe;
          gameState.player.stats = { ...CLASSES_CONFIG[classe].baseStats };
          document.getElementById("classeDescricao").innerText = CLASSES_CONFIG[classe].descricao;
          renderizarSeletorClasses();
        };
        container.appendChild(btn);
      });
      document.getElementById("classeDescricao").innerText = CLASSES_CONFIG[gameState.player.classe].descricao;
    }

    // Gerador de Código de Save
    function gerarCodigoSave() {
      const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
      let code = "ETER-";
      for (let i = 0; i < 4; i++) {
        code += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return code;
    }

    async function iniciarNovoJogo() {
      const nomeInput = document.getElementById("inputNome").value.trim();
      if (!nomeInput) {
        alert("Por favor, digite o nome do seu herói.");
        return;
      }

      gameState.player.nome = nomeInput;
      gameState.saveCode = gerarCodigoSave();
      gameState.player.stats = { ...CLASSES_CONFIG[gameState.player.classe].baseStats };
      
      // Ajuste de HP/MP inicial baseado em CON e INT
      gameState.player.maxHp = 80 + (gameState.player.stats.con * 4);
      gameState.player.hp = gameState.player.maxHp;
      gameState.player.maxMp = 40 + (gameState.player.stats.int * 3);
      gameState.player.mp = gameState.player.maxMp;

      transicionarParaJogo();
      await salvarProgressoNuvem();
      await avancarHistoriaIA("O herói " + gameState.player.nome + ", da classe " + gameState.player.classe + ", desperta nas portas de um reino envolto em mistério e perigo.");
    }

    function transicionarParaJogo() {
      document.getElementById("screenSetup").classList.add("hidden");
      document.getElementById("screenGame").classList.remove("hidden");
      document.getElementById("gameHeaderInfo").classList.remove("hidden");
      document.getElementById("headerSaveCode").innerText = "SALA: " + gameState.saveCode;
      document.getElementById("inputSaveCodeDisplay").value = gameState.saveCode;
      atualizarInterfaceCompleta();
    }

    function atualizarInterfaceCompleta() {
      document.getElementById("charNameDisplay").innerText = gameState.player.nome;
      document.getElementById("charClassDisplay").innerText = `${gameState.player.classe} • Nível ${gameState.player.nivel}`;
      document.getElementById("charLevelDisplay").innerText = gameState.player.nivel;

      // Barras
      const hpPct = Math.max(0, Math.min(100, (gameState.player.hp / gameState.player.maxHp) * 100));
      document.getElementById("hpBar").style.width = hpPct + "%";
      document.getElementById("hpText").innerText = `${gameState.player.hp} / ${gameState.player.maxHp}`;

      const mpPct = Math.max(0, Math.min(100, (gameState.player.mp / gameState.player.maxMp) * 100));
      document.getElementById("mpBar").style.width = mpPct + "%";
      document.getElementById("mpText").innerText = `${gameState.player.mp} / ${gameState.player.maxMp}`;

      const xpPct = Math.max(0, Math.min(100, (gameState.player.xp / gameState.player.maxXp) * 100));
      document.getElementById("xpBar").style.width = xpPct + "%";
      document.getElementById("xpText").innerText = `${gameState.player.xp} / ${gameState.player.maxXp}`;

      // Atributos
      ['for', 'des', 'con', 'int', 'sab', 'car', 'sor', 'per'].forEach(st => {
